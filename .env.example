# ==============================================================================
# FlameAGI Environment Configuration
# Copy this file to .env and configure your API keys and local preferences.
# ==============================================================================

# Google Gemini API Key (Required for cloud intelligence, image generation, vision)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini model used for conversational agent and planning
FLAME_GEMINI_MODEL=gemini-2.5-flash

# Local LLM Server (Ollama) endpoint for zero-cost offline inference
OLLAMA_URL=http://127.0.0.1:11434
FLAME_LOCAL_MODEL=qwen2.5-coder:1.5b

# Optional Alternative Model Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional Automation Integrations
ZAPIER_NLA_API_KEY=

